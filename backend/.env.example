# ---------------------------------------------------------------------------
# Copy to .env and fill in. The server refuses to start if anything required
# here is missing — nothing security-relevant defaults to "allow".
# ---------------------------------------------------------------------------

# Point this at the least-privilege role, not postgres. Create it first:
#   psql "$ADMIN_URL" -v app_password="'...'" -f prisma/sql/app_role.sql
DATABASE_URL="postgresql://tickvpn_app:change-me@localhost:5432/vpndays"

NODE_ENV="development"
PORT=3001
APP_URL="http://localhost:3001"

# Dev-only endpoints that mint wallet balance. Ignored when NODE_ENV=production.
ENABLE_DEV_ROUTES="true"

# Real WireGuard nodes vs. the in-process mock. Keep false until a node exists.
USE_REAL_NODES="false"

# Stripe. Optional until underwriting is done; required when NODE_ENV=production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Qualifying-usage classifier (Technical Decisions D2). A peer counts as "in
# use" only when its handshake is fresh AND it has moved this many bytes.
QUALIFYING_BYTES=5242880
HANDSHAKE_FRESH_SECONDS=180

# Product policy.
MINUTES_PER_DAY_PASS=1440
MAX_DEVICES_PER_USER=3

# Auth.
LOGIN_TOKEN_TTL_MINUTES=10
SESSION_TTL_HOURS=720
LOGIN_RATE_LIMIT_PER_HOUR=5
COOKIE_SECURE="false"

# Node agents.
NODE_AGENT_PORT=8787
NODE_AGENT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Magic-link delivery
# ---------------------------------------------------------------------------
# console = print the link, send nothing (local only; refused in production)
# resend  = HTTPS API, works with no domain of your own — recommended
# smtp    = Gmail or any SMTP server; testing only, see backend/README.md
EMAIL_PROVIDER="console"

# Until you own a domain, Resend lets you send from its shared sender to your
# own verified address. Swap this for noreply@yourdomain once DNS is set up.
EMAIL_FROM="TickVPN <onboarding@resend.dev>"

# Safety catch while testing: only these addresses receive mail. Comma
# separated. Leave empty to allow anyone (do that only once DNS is set up).
EMAIL_ALLOWLIST="harishraoyadagiri@gmail.com"

RESEND_API_KEY=""

# Only if EMAIL_PROVIDER=smtp. For Gmail this is an App Password from
# https://myaccount.google.com/apppasswords — never your account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
